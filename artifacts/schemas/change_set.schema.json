{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangeSet",
  "description": "Proof-of-work artifact for a completed task. Every file in 'files' must fall under the task's scope_paths and every change must trace back to a spec acceptance criterion.",
  "type": "object",
  "required": [
    "feature_id",
    "task_ref",
    "spec_criterion_refs",
    "owner",
    "base_ref",
    "compare_ref",
    "files",
    "produced_at"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^T[0-9]{3}$",
      "description": "ID of the task in tasks.json this change set fulfills."
    },
    "spec_criterion_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^AC[0-9]+$" },
      "description": "Mirrored from the referenced task. Validators verify equality."
    },
    "owner": {
      "type": "string",
      "enum": ["coding-fe", "coding-be", "coding-devops", "test", "docs", "security"]
    },
    "base_ref": { "type": "string", "description": "Git ref of base." },
    "compare_ref": { "type": "string", "description": "Git ref of head after changes." },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "change_type"],
        "properties": {
          "path": { "type": "string" },
          "change_type": {
            "type": "string",
            "enum": ["added", "modified", "deleted", "renamed"]
          },
          "renamed_from": { "type": "string" },
          "lines_added": { "type": "integer", "minimum": 0 },
          "lines_removed": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "produced_at": { "type": "string", "format": "date-time" },
    "test_evidence": {
      "type": "object",
      "properties": {
        "test_plan_ref": { "type": "string" },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "coverage_delta": { "type": "number" }
      }
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "verdict"],
        "properties": {
          "reviewer": { "type": "string" },
          "verdict": { "type": "string", "enum": ["approve", "request_changes", "comment"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
