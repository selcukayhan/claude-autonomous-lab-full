{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spec",
  "description": "Machine-readable mirror of specs/<feature_id>/spec.md. The locked spec is the source of truth for all downstream artifacts.",
  "type": "object",
  "required": [
    "feature_id",
    "version",
    "status",
    "title",
    "context",
    "objectives",
    "constraints",
    "acceptance_criteria"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$",
      "description": "Matches the specs/<feature_id>/ directory name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer. Major bump for breaking changes to acceptance criteria after lock."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "locked", "amended", "deprecated"],
      "description": "Lifecycle state. Downstream agents only consume spec when status == locked or amended."
    },
    "title": { "type": "string" },
    "context": {
      "type": "string",
      "description": "Why this feature exists; the user problem; non-goals."
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[0-9]+$",
            "description": "Stable, referenceable ID, e.g., AC1."
          },
          "criterion": { "type": "string" },
          "verification": {
            "type": "string",
            "enum": ["test", "manual", "inspection", "demo"],
            "default": "test"
          },
          "priority": {
            "type": "string",
            "enum": ["must", "should", "could"],
            "default": "must"
          }
        }
      }
    },
    "non_functional": {
      "type": "object",
      "description": "Perf, scale, security, a11y, etc. Free-form by category."
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clarifying_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Open questions. Must be empty before status can advance to locked."
    },
    "lock_record": {
      "type": "object",
      "description": "Populated by orchestrator on spec_lock_review approval.",
      "properties": {
        "approver": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "approval_notes": { "type": "string" }
      }
    }
  }
}
