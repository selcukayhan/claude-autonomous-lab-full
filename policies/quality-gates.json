  },
  "hitl_required": [
    "spec_lock_review",
    "plan_lock_review",
    "pre_merge_review",
    "constitution_amendment",
    "public_api_change_post_lock"
  ],
  "constitution_amendment": {
    "approver": "human",
    "min_approvers": 1,
    "record_in": "specs/<feature_id>-constitution-amendment/evidence/run_<id>.json"
  }
}
