{
  "agents": {
    "security": { "enabled": false },
    "release":  { "enabled": false }
  },
  "defaults": {
    "verbosity": "low",
    "fail_if_disabled_gate": false
  },
  "spec_driven": {
    "mode": "auto_with_hitl_stops",
    "feature_id_pattern": "^[0-9]{3}-[a-z0-9-]+$",
    "auto_allocate_feature_id": true,
    "stop_on_hitl": true,
    "stop_on_validation_failure": true,
    "retry_budget_per_phase": 1
  },
  "_ownership_doc": "default_ownership is the global LAST-RESORT fallback. Resolution order for a change_set's effective ownership: (1) specs/<feature_id>/team_plan.json#ownership[<role>] if declared, (2) policies/project-shapes/<team_plan.project_shape>.json#ownership[<role>] if a shape is set, (3) this map. Coding roles (coding-fe/be/devops) deliberately have no entry here — every feature MUST pick a project_shape OR declare its own ownership so coding work is never silently routed to a default that may not exist on disk.",
  "default_ownership": {
    "docs":           ["README.md", "docs/**", "specs/*/spec.md", "specs/*/plan.md"],
    "requirements":   ["specs/*/spec.md", "specs/*/spec.json", "specs/*/state.json"],
    "planning":       ["specs/*/plan.md", "specs/*/plan.json", "specs/*/tasks.json"],
    "architecture":   ["specs/*/contracts/**", "specs/*/team_plan.json"],
    "uiux-researcher":["specs/*/ux_research.json"],
    "uiux-designer":  ["specs/*/ux_design.json"],
    "test":           ["specs/*/evidence/test_plan.json"],
    "security":       ["specs/*/evidence/security_summary.json"],
    "release":        ["specs/*/evidence/release.json"],
    "context-manager":["runs/learned_patterns.json", "runs/benefit_report.json"],
    "experiment":     ["runs/experiments.json"],
    "policy":         ["specs/*/state.json"],
    "bootstrap":      ["runs/framework_map.json"]
  }
}
